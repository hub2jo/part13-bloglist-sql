### create a user (password is sent but ignored)
POST http://localhost:3001/api/users
Content-Type: application/json

{
  "username": "lukaong",
  "name": "Luka Ong",
  "password": "secret"
}

### create another user
POST http://localhost:3001/api/users
Content-Type: application/json

{
  "username": "superdog",
  "name": "Super Luka"
}

### list all users
GET http://localhost:3001/api/users

### one user by id
GET http://localhost:3001/api/users/1

### user that doesn't exist (404)
GET http://localhost:3001/api/users/9999

### change username (the URL uses the CURRENT username)
PUT http://localhost:3001/api/users/superdog
Content-Type: application/json

{
  "username": "superdoperdog"
}

### change name
PUT http://localhost:3001/api/users/superdoperdog
Content-Type: application/json

{
  "name": "Super Doper Dog"
}

### PUT unknown username (404)
PUT http://localhost:3001/api/users/nobody
Content-Type: application/json

{
  "name": "Ghost"
}

### convert an old username to an email
PUT http://localhost:3001/api/users/lukaong
Content-Type: application/json

{
  "username": "luka@example.com"
}

###
PUT http://localhost:3001/api/users/superdoperdog
Content-Type: application/json

{
  "username": "superdoperdog@example.com"
}

### not an email (400)
POST http://localhost:3001/api/users
Content-Type: application/json

{
  "username": "testnoemail",
  "name": "Mo email"
}

### duplicate email (400) — send after the valid one
POST http://localhost:3001/api/users
Content-Type: application/json

{
  "username": "luka@example.com",
  "name": "Someone Else"
}

### two problems at once (400, two messages)
POST http://localhost:3001/api/users
Content-Type: application/json

{
  "username": "nope",
  "name": ""
}

### username missing (400)
POST http://localhost:3001/api/users
Content-Type: application/json

{
  "name": "No Username"
}

### change username to a non-email (400)
PUT http://localhost:3001/api/users/luka@example.com
Content-Type: application/json

{
  "username": "not-an-email"
}